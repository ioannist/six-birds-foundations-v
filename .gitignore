/paper/notes/
/paper/figures/*_template.tex
/paper/tables/*_template.tex
/paper/submission/*-template.*
/paper/submission/zenodo-metadata.json
/paper/submission/zenodo-release.json
/scripts/make_review_zip.sh

# Retired external-review archives.
six-birds-foundations-v_v*.zip
# Legacy name, kept so pre-rename artifacts stay ignored.
six-birds-cognition_v*.zip

# OS/editor cruft
.DS_Store

# Sibling papers checkout (separate repo: ioannist/six-birds-papers).
# Present locally as a symlink or a nested clone; never tracked here.
/six-birds-papers

# Agent drafting guides and rewrite plans (kept on disk)
/paper/notation_and_terminology.md
/docs/READABILITY_*.md

